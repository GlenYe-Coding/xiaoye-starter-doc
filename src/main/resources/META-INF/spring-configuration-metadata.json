{
  "groups": [
    {
      "name": "xiaoye.doc",
      "type": "com.xiaoye.starter.doc.config.XiaoyeDocProperties",
      "description": "API 文档配置"
    }
  ],
  "properties": [
    {
      "name": "xiaoye.doc.enabled",
      "type": "boolean",
      "description": "是否启用文档模块",
      "defaultValue": true
    },
    {
      "name": "xiaoye.doc.title",
      "type": "java.lang.String",
      "description": "API 文档标题",
      "defaultValue": "XiaoYe API Documentation"
    },
    {
      "name": "xiaoye.doc.version",
      "type": "java.lang.String",
      "description": "API 版本号",
